{
  "manifest_version": 3,
  "name": "Ice Shield",
  "version": "1.1.0",
  "description": "Iceova zaštita: phishing i malware stranice (javne liste i Google Safe Browsing), Global Privacy Control.",
  "permissions": [
    "webNavigation",
    "tabs",
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "gpc",
        "enabled": true,
        "path": "gpc-rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "gpc.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "key": "",
  "icons": {
    "16": "icons/ice-16.png",
    "32": "icons/ice-32.png",
    "48": "icons/ice-48.png",
    "128": "icons/ice-128.png"
  }
}

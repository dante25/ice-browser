{
  "manifest_version": 3,
  "name": "Ice Shield",
  "version": "1.0.0",
  "description": "Iceova zaštita: phishing i malware stranice, Global Privacy Control.",
  "permissions": ["webNavigation", "tabs", "storage", "unlimitedStorage", "declarativeNetRequest", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "declarative_net_request": {
    "rule_resources": [{ "id": "gpc", "enabled": true, "path": "gpc-rules.json" }]
  },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["gpc.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN" }
  ]
}

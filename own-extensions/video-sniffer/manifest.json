{
  "manifest_version": 3,
  "name": "Video Sniffer",
  "version": "1.2.2",
  "description": "Detects videos (HLS, DASH, MP4, WebM...) by watching network traffic, page scripts, players and the DOM.",
  "permissions": [
    "webRequest",
    "webNavigation",
    "downloads",
    "storage",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Video Sniffer",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://twitcasting.tv/*",
        "*://*.twitcasting.tv/*",
        "*://kick.com/*",
        "*://*.kick.com/*",
        "*://chaturbate.com/*",
        "*://*.chaturbate.com/*",
        "*://chaturbate.eu/*",
        "*://*.chaturbate.eu/*",
        "*://chaturbate.global/*",
        "*://*.chaturbate.global/*",
        "*://canva.com/*",
        "*://*.canva.com/*",
        "*://ok.ru/*",
        "*://*.ok.ru/*",
        "*://vk.com/*",
        "*://*.vk.com/*",
        "*://vk.ru/*",
        "*://*.vk.ru/*",
        "*://vkvideo.ru/*",
        "*://*.vkvideo.ru/*"
      ],
      "js": [
        "sites.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

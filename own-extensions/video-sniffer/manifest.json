{
  "manifest_version": 3,
  "name": "Video Sniffer",
  "version": "1.1.6",
  "description": "Detects videos (HLS, DASH, MP4, WebM...) by watching network traffic, page scripts, players and the DOM.",
  "permissions": [
    "webRequest",
    "webNavigation",
    "downloads",
    "storage",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Video Sniffer",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ]
}

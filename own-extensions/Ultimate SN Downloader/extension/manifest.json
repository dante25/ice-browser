{
  "manifest_version": 3,
  "name": "Ultimate SN Downloader",
  "version": "0.11.5",
  "description": "Download photos and videos from Instagram, Facebook, X, DeviantArt and Flickr, and images from any gallery page (Image Host Grabber with the host file).",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Ultimate SN Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "permissions": [
    "offscreen",
    "storage",
    "tabs",
    "unlimitedStorage",
    "declarativeNetRequest",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.deviantart.com/*",
    "https://www.flickr.com/*",
    "https://api.flickr.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*",
    "https://*.wixmp.com/*",
    "https://*.deviantart.net/*",
    "https://*.staticflickr.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.deviantart.com/*",
        "https://www.flickr.com/*"
      ],
      "js": [
        "content/main_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.deviantart.com/*",
        "https://www.flickr.com/*"
      ],
      "js": [
        "content/common.js",
        "content/ig.js",
        "content/fb.js",
        "content/x.js",
        "content/da.js",
        "content/fl.js",
        "content/quick.js",
        "content/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open Ultimate SN Downloader"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline' 'unsafe-eval'; object-src 'self'"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "sandbox": {
    "pages": [
      "ui/ih_sandbox.html"
    ]
  }
}
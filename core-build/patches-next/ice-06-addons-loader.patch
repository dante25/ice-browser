+  base::FilePath ice_install_dir;
+  if (base::PathService::Get(base::DIR_ASSETS, &ice_install_dir)) {
+    const base::FilePath addons_dir =
+        ice_install_dir.AppendASCII(ice::kIceAddonsDirName);
+    PrefService* prefs = profile_->GetPrefs();
+    for (const IceAddon& addon : kIceAddons) {
+      if (prefs->FindPreference(addon.enable_pref) &&
+          !prefs->GetBoolean(addon.enable_pref)) {
+        continue;
+      }
+      std::string extension_id;

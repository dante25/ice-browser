 namespace {
 
+// Ice: add-ons shipped unchanged in <install>/dodaci/<dir> and loaded like
+// --load-extension (normal unpacked extensions, not built-ins), each only when
+// its profile pref is on.
+struct IceAddon {
+  const char* dir;
+  const char* enable_pref;
+};
+constexpr IceAddon kIceAddons[] = {
+    {"sn-downloader", ice::kSnDownloaderEnabledPref},
+    {"video-sniffer", ice::kVideoSnifferEnabledPref},
+};
+
 // Wait this long after an extensions becomes idle before updating it.

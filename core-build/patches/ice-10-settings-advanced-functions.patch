+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {RestartType} from '../relaunch_mixin_lit.js';
+
+import type {SettingsIceAdvancedPageElement} from './ice_advanced_page.js';
+
+export function getHtml(this: SettingsIceAdvancedPageElement) {
+  // clang-format off
+  return html`<!--_html_template_start_-->
+<settings-section page-title="$i18n{iceAdvancedPageTitle}"
+    class="cr-centered-card-container">
+  <settings-toggle-button id="snDownloader"
+      pref-key="ice.addons.sn_downloader_enabled"
+      label="$i18n{iceAdvancedSnDownloaderLabel}"
+      sub-label="$i18n{iceAdvancedSnDownloaderSubLabel}"
+      @settings-boolean-control-change="${this.onSettingsBooleanControlChange_}">
+  </settings-toggle-button>
+  <div class="hr"></div>
+  <settings-toggle-button id="videoSniffer"
+      pref-key="ice.addons.video_sniffer_enabled"
+      label="$i18n{iceAdvancedVideoSnifferLabel}"
+      sub-label="$i18n{iceAdvancedVideoSnifferSubLabel}"
+      @settings-boolean-control-change="${this.onSettingsBooleanControlChange_}">
+  </settings-toggle-button>
+  <div class="hr"></div>
+  <settings-toggle-button id="multiselectYoutube"
+      pref-key="ice.builtins.multiselect_youtube_enabled"
+      label="$i18n{iceAdvancedMultiselectLabel}"
+      sub-label="$i18n{iceAdvancedMultiselectSubLabel}"
+      @settings-boolean-control-change="${this.onSettingsBooleanControlChange_}">
+  </settings-toggle-button>
+  <div class="cr-row">
+    <div id="restartNote" class="flex cr-padded-text cr-secondary-text">
+      $i18n{iceAdvancedRestartNote}
+    </div>
+    ${this.showRestartButton_ ? html`
+      <cr-button id="restartButton" @click="${this.onRestartClick_}">
+        $i18n{restart}
+      </cr-button>
+    ` : ''}
+  </div>
+
+  ${this.shouldShowRelaunchDialog ? html`
+    <relaunch-confirmation-dialog .restartType="${RestartType.RESTART}"
+        @close="${this.onRelaunchDialogClose}">
+    </relaunch-confirmation-dialog>
+  ` : ''}
+</settings-section>
+<!--_html_template_end_-->`;
+  // clang-format on
+}

+// Copyright 2026 The Ice Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-ice-advanced-page' ("Napredne funkcije") holds the on/off
+ * switches for Ice add-ons and built-in features. The prefs are read once at
+ * browser startup, so changes are applied after a restart.
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import '../controls/settings_toggle_button.js';
+import '../relaunch_confirmation_dialog.js';
+import '../settings_page/settings_section.js';
+
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {RelaunchMixinLit, RestartType} from '../relaunch_mixin_lit.js';
+import {getSearchManager} from '../search_settings.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+import {getCss as getSettingsSharedCss} from '../settings_shared_lit.css.js';
+
+import {getHtml} from './ice_advanced_page.html.js';
+
+const SettingsIceAdvancedPageElementBase = RelaunchMixinLit(CrLitElement);
+
+export class SettingsIceAdvancedPageElement extends
+    SettingsIceAdvancedPageElementBase implements SettingsPlugin {
+  static get is() {
+    return 'settings-ice-advanced-page';
+  }
+
+  static override get styles() {
+    return [
+      getSettingsSharedCss(),
+    ];
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      showRestartButton_: {type: Boolean},
+    };
+  }
+
+  protected accessor showRestartButton_: boolean = false;
+
+  protected onSettingsBooleanControlChange_() {
+    // Any change made by the user only takes effect after a restart.
+    this.showRestartButton_ = true;
+  }
+
+  protected onRestartClick_(e: Event) {
+    e.stopPropagation();
+    this.performRestart(RestartType.RESTART);
+  }
+
+  // SettingsPlugin implementation
+  async searchContents(query: string) {
+    const searchRequest = await getSearchManager().search(query, this);
+    return searchRequest.getSearchResult();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-ice-advanced-page': SettingsIceAdvancedPageElement;
+  }
+}
+
+customElements.define(
+    SettingsIceAdvancedPageElement.is, SettingsIceAdvancedPageElement);

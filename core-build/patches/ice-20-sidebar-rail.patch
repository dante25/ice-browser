+// Copyright 2026 The Ice Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/ice/ice_overlay_panel.h"
+
+#include <algorithm>
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/task/single_thread_task_runner.h"
+#include "ui/base/mojom/dialog_button.mojom.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/text_constants.h"
+#include "ui/views/bubble/bubble_border.h"
+#include "ui/views/bubble/bubble_dialog_delegate_view.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/style/typography.h"
+#include "ui/views/view.h"
+
+namespace ice {
+
+namespace {
+
+// Inner padding of the panel.
+constexpr int kPanelMargin = 16;
+
+// A toggle this soon after the panel closed itself is treated as the press
+// that closed it (see IceOverlayPanel::Toggle()).
+constexpr base::TimeDelta kReopenGuard = base::Milliseconds(300);
+
+// TODO(ice): localize; the feature cards come in a later patch.
+constexpr char16_t kPanelTitle[] = u"Funkcije";
+
+}  // namespace
+
+struct IceOverlayPanel::Bubble {
+  Bubble() = default;
+  Bubble(const Bubble&) = delete;
+  Bubble& operator=(const Bubble&) = delete;
+  ~Bubble() {
+    // The widget must be destroyed before its delegate.
+    widget.reset();
+    delegate.reset();
+  }
+
+  std::unique_ptr<views::BubbleDialogDelegate> delegate;
+  std::unique_ptr<views::Widget> widget;
+};
+
+IceOverlayPanel::IceOverlayPanel(views::View* anchor_view)
+    : anchor_view_(anchor_view) {}
+
+IceOverlayPanel::~IceOverlayPanel() = default;
+
+bool IceOverlayPanel::IsShowing() const {
+  return !!bubble_;
+}
+
+void IceOverlayPanel::Toggle() {
+  if (IsShowing()) {
+    Close();
+    return;
+  }
+  if (!last_closed_time_.is_null() &&
+      base::TimeTicks::Now() - last_closed_time_ < kReopenGuard) {
+    return;
+  }
+  Show();
+}
+
+void IceOverlayPanel::Show() {
+  if (IsShowing() || !anchor_view_->GetWidget() ||
+      !anchor_view_->IsDrawn()) {
+    return;
+  }
+
+  auto bubble = std::make_unique<Bubble>();
+  // LEFT_TOP: the panel is placed to the right of the anchor (the rail), with
+  // its top at the rail's top, i.e. directly over the web contents.
+  bubble->delegate = std::make_unique<views::BubbleDialogDelegate>(
+      anchor_view_.get(), views::BubbleBorder::LEFT_TOP);
+  views::BubbleDialogDelegate* const delegate = bubble->delegate.get();
+  delegate->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  delegate->SetShowTitle(false);
+  delegate->SetShowCloseButton(false);
+  delegate->SetAccessibleTitle(std::u16string(kPanelTitle));
+  delegate->set_margins(gfx::Insets(kPanelMargin));
+  delegate->set_close_on_deactivate(true);
+
+  // Placeholder content: title only. Sized so that the visible panel is
+  // kPanelWidth wide and as tall as the rail.
+  auto contents = std::make_unique<views::View>();
+  auto* layout = contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+  auto* title = contents->AddChildView(std::make_unique<views::Label>(
+      std::u16string(kPanelTitle), views::style::CONTEXT_DIALOG_TITLE));
+  title->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  contents->SetPreferredSize(
+      gfx::Size(kPanelWidth - 2 * kPanelMargin,
+                std::max(anchor_view_->height() - 2 * kPanelMargin,
+                         title->GetPreferredSize().height())));
+  delegate->SetContentsView(std::move(contents));
+
+  bubble->widget = views::BubbleDialogDelegate::CreateBubble(
+      delegate, base::BindOnce(&IceOverlayPanel::OnBubbleClosing,
+                               weak_factory_.GetWeakPtr()));
+  bubble_ = std::move(bubble);
+  bubble_->widget->Show();
+}
+
+void IceOverlayPanel::Close() {
+  if (IsShowing()) {
+    OnBubbleClosing(views::Widget::ClosedReason::kUnspecified);
+  }
+}
+
+void IceOverlayPanel::OnBubbleClosing(views::Widget::ClosedReason reason) {
+  last_closed_time_ = base::TimeTicks::Now();
+  if (!bubble_) {
+    return;
+  }
+  // This can run from inside the widget's own event/activation handling, so
+  // hide now and delete (widget, then delegate) on a fresh stack. Hiding must
+  // not trigger a second (deactivation) close.
+  bubble_->delegate->set_close_on_deactivate(false);
+  bubble_->widget->Hide();
+  base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(bubble_));
+}
+
+}  // namespace ice

+namespace ice {
+
+namespace {
+
+// Vertical padding at the top and bottom of the rail, and between buttons.
+constexpr int kRailVerticalPadding = 8;
+constexpr int kRailButtonSpacing = 4;
+
+// The browser's app menu (the same menu as the toolbar's three-dot button),
+// shown with a hamburger icon and anchored to the rail.
+class IceRailAppMenuButton : public BrowserAppMenuButton {
+  METADATA_HEADER(IceRailAppMenuButton, BrowserAppMenuButton)
+
+ public:
+  explicit IceRailAppMenuButton(ToolbarView* toolbar_view)
+      : BrowserAppMenuButton(toolbar_view) {}
+  IceRailAppMenuButton(const IceRailAppMenuButton&) = delete;
+  IceRailAppMenuButton& operator=(const IceRailAppMenuButton&) = delete;
+  ~IceRailAppMenuButton() override = default;
+
+  // BrowserAppMenuButton:
+  void UpdateIcon() override {
+    UpdateIconsWithStandardColors(views::kMenuOpenIcon);
+  }
+
+  // AppMenuButton:
+  // The toolbar asks the app menu to extend to the window edge (Fitts' law)
+  // when maximized; that only makes sense in the toolbar, not in the rail.
+  void SetIsMaximizedOrFullscreen(bool maximized_or_fullscreen) override {}
+};
+
+BEGIN_METADATA(IceRailAppMenuButton)
+END_METADATA
+
+}  // namespace
+
+IceRailView::IceRailView(BrowserView* browser_view)
+    : browser_view_(browser_view) {
+  SetBackground(views::CreateSolidBackground(kColorToolbar));
+  SetBorder(views::CreateSolidSidedBorder(gfx::Insets::TLBR(0, 0, 0, 1),
+                                          kColorToolbarContentAreaSeparator));
+
+  auto* const layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical,
+      gfx::Insets::VH(kRailVerticalPadding, 0), kRailButtonSpacing));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+
+  // 1. Hamburger: Chromium's app menu.
+  auto app_menu =
+      std::make_unique<IceRailAppMenuButton>(browser_view_->toolbar());
+  app_menu->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_ACCNAME_APP));
+  app_menu->SetTooltipText(l10n_util::GetStringUTF16(IDS_APPMENU_TOOLTIP));
+  app_menu_button_ = AddChildView(std::move(app_menu));
+
+  // 2.-4. Existing pages via existing browser commands.
+  // TODO(ice): localize the rail strings.
+  AddCommandButton(kStarIcon, u"Oznake", IDC_SHOW_BOOKMARK_MANAGER);
+  AddCommandButton(vector_icons::kHistoryIcon, u"Historija", IDC_SHOW_HISTORY);
+  AddCommandButton(vector_icons::kDownloadIcon, u"Preuzimanja",
+                   IDC_SHOW_DOWNLOADS);
+
+  // 5. "Funkcije": the Ice overlay panel. Notifies on press so a press that
+  // also deactivates (and so closes) an open panel does not reopen it.
+  auto features_button = std::make_unique<ToolbarButton>(base::BindRepeating(
+      &IceRailView::ToggleFeaturesPanel, base::Unretained(this)));
+  features_button->SetVectorIcon(vector_icons::kChromeExtensionIcon);
+  features_button->SetTooltipText(u"Funkcije");
+  features_button->GetViewAccessibility().SetName(u"Funkcije");
+  features_button->button_controller()->set_notify_action(
+      views::ButtonController::NotifyAction::kOnPress);
+  AddChildView(std::move(features_button));
+
+  // 6. Settings.
+  AddCommandButton(vector_icons::kSettingsIcon, u"Postavke", IDC_OPTIONS);
+
+  // Pushes the avatar to the bottom of the rail.
+  layout->SetFlexForView(AddChildView(std::make_unique<views::View>()), 1);
+
+  // 7. Profile avatar: opens the existing profile menu bubble (the bubble is
+  // anchored to the visible avatar button, i.e. this one).
+  if (AvatarToolbarButtonInterface::CanShowForProfile(
+          browser_view_->GetProfile())) {
+    avatar_button_ = AddChildView(
+        std::make_unique<AvatarToolbarButton>(browser_view_->browser()));
+  }
+
+  panel_ = std::make_unique<IceOverlayPanel>(this);
+}
+
+IceRailView::~IceRailView() = default;
+
+gfx::Size IceRailView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  // Only the width is used; the height is the height of the contents area.
+  return gfx::Size(kRailWidth, 0);
+}
+
+void IceRailView::AddedToWidget() {
+  views::View::AddedToWidget();
+  // Done here (not in the constructor) because the app menu button needs a
+  // color provider when the toolbar pushes the badge state to it.
+  if (!toolbar_hooked_ && browser_view_->toolbar()) {
+    toolbar_hooked_ = true;
+    browser_view_->toolbar()->SetIceRailButtons(app_menu_button_,
+                                                avatar_button_);
+  }
+}
+
+void IceRailView::VisibilityChanged(views::View* starting_from,
+                                    bool is_visible) {
+  views::View::VisibilityChanged(starting_from, is_visible);
+  // E.g. entering fullscreen hides the rail: close the panel with it.
+  if (!is_visible && panel_) {
+    panel_->Close();
+  }
+}
+
+void IceRailView::AddCommandButton(const gfx::VectorIcon& icon,
+                                   const std::u16string& name,
+                                   int command_id) {
+  auto button = std::make_unique<ToolbarButton>(
+      base::BindRepeating(&IceRailView::ExecuteBrowserCommand,
+                          base::Unretained(this), command_id));
+  button->SetVectorIcon(icon);
+  button->SetTooltipText(name);
+  button->GetViewAccessibility().SetName(name);
+  AddChildView(std::move(button));
+}
+
+void IceRailView::ExecuteBrowserCommand(int command_id) {
+  panel_->Close();
+  chrome::ExecuteCommand(browser_view_->browser(), command_id);
+}
+
+void IceRailView::ToggleFeaturesPanel() {
+  panel_->Toggle();
+}
+
+BEGIN_METADATA(IceRailView)
+END_METADATA
+

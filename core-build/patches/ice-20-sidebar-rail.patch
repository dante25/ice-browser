+// Copyright 2026 The Ice Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_ICE_ICE_OVERLAY_PANEL_H_
+#define CHROME_BROWSER_UI_VIEWS_ICE_ICE_OVERLAY_PANEL_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "ui/views/widget/widget.h"
+
+namespace views {
+class View;
+}  // namespace views
+
+namespace ice {
+
+// The Ice sidebar panel ("Funkcije"). It is a bubble widget anchored to the
+// Ice rail and opens to the right of it, on top of the web contents: the page
+// is never resized or moved. It closes on Escape, when it loses activation
+// (click anywhere outside it) or when Toggle() is called while it is shown.
+//
+// Content is a placeholder (title only) for now.
+class IceOverlayPanel {
+ public:
+  static constexpr int kPanelWidth = 300;
+
+  // `anchor_view` (the rail) must outlive this object.
+  explicit IceOverlayPanel(views::View* anchor_view);
+  IceOverlayPanel(const IceOverlayPanel&) = delete;
+  IceOverlayPanel& operator=(const IceOverlayPanel&) = delete;
+  ~IceOverlayPanel();
+
+  bool IsShowing() const;
+
+  // Shows the panel if it is hidden, closes it if it is shown. A toggle that
+  // arrives right after the panel closed itself (because the same mouse press
+  // took activation away from it) only closes and does not reopen it.
+  void Toggle();
+
+  void Show();
+  void Close();
+
+ private:
+  // The bubble delegate and its (client owned) widget. The delegate must
+  // outlive the widget; both are deleted together.
+  struct Bubble;
+
+  // Called synchronously whenever the bubble widget is asked to close
+  // (Escape, deactivation, Close()).
+  void OnBubbleClosing(views::Widget::ClosedReason reason);
+
+  const raw_ptr<views::View> anchor_view_;
+  std::unique_ptr<Bubble> bubble_;
+  base::TimeTicks last_closed_time_;
+
+  base::WeakPtrFactory<IceOverlayPanel> weak_factory_{this};
+};
+
+}  // namespace ice
+
+#endif  // CHROME_BROWSER_UI_VIEWS_ICE_ICE_OVERLAY_PANEL_H_

 namespace {
 
+// Ice: add-ons that can be switched off in settings. Every other add-on in
+// <install>/dodaci/ is always loaded.
+struct IceAddonSwitch {
+  const char* dir;
+  const char* enable_pref;
+};
+constexpr IceAddonSwitch kIceAddonSwitches[] = {
+    {"sn-downloader", ice::kSnDownloaderEnabledPref},
+    {"video-sniffer", ice::kVideoSnifferEnabledPref},
+};
+
+// Runs on the extension file task runner: the add-on directories (those with
+// a manifest.json), sorted by name.
+std::vector<base::FilePath> ListIceAddonDirs(const base::FilePath& root) {
+  std::vector<base::FilePath> dirs;
+  base::FileEnumerator enumerator(root, /*recursive=*/false,
+                                  base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath dir = enumerator.Next(); !dir.empty();
+       dir = enumerator.Next()) {
+    if (base::PathExists(dir.Append(kManifestFilename))) {
+      dirs.push_back(dir);
+    }
+  }
+  std::sort(dirs.begin(), dirs.end());
+  return dirs;
+}

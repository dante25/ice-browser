+void ExtensionService::LoadIceAddons(std::vector<base::FilePath> addon_dirs) {
+  PrefService* prefs = profile_->GetPrefs();
+  for (const base::FilePath& dir : addon_dirs) {
+    bool enabled = true;
+    for (const IceAddonSwitch& addon_switch : kIceAddonSwitches) {
+      if (dir.BaseName().value() == addon_switch.dir &&
+          prefs->FindPreference(addon_switch.enable_pref)) {
+        enabled = prefs->GetBoolean(addon_switch.enable_pref);
+      }
+    }
+    if (!enabled) {
+      continue;
+    }
+    // Same path as --load-extension: a normal unpacked extension, unchanged.
+    std::string extension_id;
+    UnpackedInstaller::Create(profile_)->LoadFromCommandLine(
+        dir, &extension_id, /*only_allow_apps=*/false);
+  }
+}

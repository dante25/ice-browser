+namespace {
+base::flat_map<extensions::ExtensionId, base::TimeTicks>& InstallTimes() {
+  static base::NoDestructor<
+      base::flat_map<extensions::ExtensionId, base::TimeTicks>>
+      times;
+  return *times;
+}
+}  // namespace
+
+void MarkIceBuiltinInstalling(const extensions::ExtensionId& id) {
+  InstallTimes()[id] = base::TimeTicks::Now();
+}
+
+bool ShouldSuppressIceBuiltinTab(const extensions::ExtensionId& id) {
+  auto it = InstallTimes().find(id);
+  return it != InstallTimes().end() &&
+         base::TimeTicks::Now() - it->second < base::Minutes(2);
+}

+#ifndef EXTENSIONS_COMMON_ICE_BUILTIN_IDS_H_
+#define EXTENSIONS_COMMON_ICE_BUILTIN_IDS_H_
+
+#include <string_view>
+
+namespace ice {
+
+// IDs of Ice's built-in features (component extensions). Keep in sync with
+// kIceBuiltins in chrome/browser/extensions/ice_builtins.cc.
+inline constexpr std::string_view kIceBuiltinIds[] = {
+    "cmedhionkhpnakcndndgjdbohmhepckk", "oncbjlgldmiagjophlhobkogeladjijl",
+    "fhnegjjodccfaliddboelcleikbmapik", "dddapfimfefnombikhnbckhjmfkggifl",
+    "ofgdcdohlhjfdhbnfkikfeakhpojhpgm", "eekailopagacbcdloonjhbiecobagjci",
+    "gkjljknnkogcgndejajchomapofgiinf", "jinenhpepbpkepablpjjchejlabbpken",
+    "gpgbiinpmelaihndlegbgfkmnpofgfei", "dammfdepmngjjoidfdbhkjboecgceamb",
+    "gjoijpfmdhbjkkgnmahganhoinjjpohk", "cnojnbdhbhnkbcieeekonklommdnndci",
+    "iaiomicjabeggjcfkbimgmglanimpnae", "cbhfdchmklhpcngcgjmpdbjakdggkkjp",
+    "nlkaejimjacpillmajjnopmpbkbnocid", "lbincgmkngjhncpmjjmghblelehjilfg",
+    "bblfilgjmibmjophkgpigfedganlieod",
+};
+
+// True for Ice built-ins. They are loaded as component extensions but must
+// keep the privileges of a normal Chrome Web Store install.
+inline bool IsIceBuiltinId(std::string_view id) {
+  for (std::string_view builtin_id : kIceBuiltinIds) {
+    if (id == builtin_id) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace ice
+
+#endif  // EXTENSIONS_COMMON_ICE_BUILTIN_IDS_H_

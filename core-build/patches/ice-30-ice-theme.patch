+#ifndef CHROME_BROWSER_UI_COLOR_ICE_COLOR_MIXER_H_
+#define CHROME_BROWSER_UI_COLOR_ICE_COLOR_MIXER_H_
+
+#include "ui/color/color_provider_key.h"
+
+namespace ui {
+class ColorProvider;
+}
+
+// Adds the Ice default browser colors (light and dark) to |provider|. Only
+// applies when the user has no theme: no extension/autogenerated theme, no
+// user color, no GTK/Qt system theme, no forced colors / high contrast.
+// Added before the native and custom theme mixers so those still win.
+void AddIceColorMixer(ui::ColorProvider* provider,
+                      const ui::ColorProviderKey& key);
+
+#endif  // CHROME_BROWSER_UI_COLOR_ICE_COLOR_MIXER_H_

+// Copyright 2026 The Ice Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/color/ice_color_mixer.h"
+
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_mixer.h"
+#include "ui/color/color_provider.h"
+#include "ui/color/color_recipe.h"
+#include "ui/color/system_theme.h"
+
+namespace {
+
+struct IcePalette {
+  SkColor frame;
+  SkColor frame_inactive;
+  SkColor toolbar;          // Toolbar, active tab, Ice rail.
+  SkColor tab_hover;        // Inactive tab under the mouse.
+  SkColor omnibox;          // Location bar ("pill") background.
+  SkColor text;             // Active tab, toolbar and omnibox text.
+  SkColor text_muted;       // Inactive tabs, dimmed omnibox text.
+  SkColor icon;             // Toolbar buttons.
+  SkColor separator;
+};
+
+// Sampled from docs/gui/tema-svijetla.png and docs/gui/tema-tamna.png.
+constexpr IcePalette kIceLight = {
+    .frame = SkColorSetRGB(0xE3, 0xFD, 0xFF),
+    .frame_inactive = SkColorSetRGB(0xEA, 0xFD, 0xFF),
+    .toolbar = SkColorSetRGB(0xD1, 0xF7, 0xFF),
+    .tab_hover = SkColorSetRGB(0xD9, 0xFA, 0xFF),
+    .omnibox = SkColorSetRGB(0xE3, 0xFD, 0xFF),
+    .text = SkColorSetRGB(0x0B, 0x3A, 0x4A),
+    .text_muted = SkColorSetRGB(0x4C, 0x7A, 0x86),
+    .icon = SkColorSetRGB(0x0B, 0x3A, 0x4A),
+    .separator = SkColorSetRGB(0xB8, 0xE0, 0xE9),
+};
+
+constexpr IcePalette kIceDark = {
+    .frame = SkColorSetRGB(0x2C, 0x2C, 0x2C),
+    .frame_inactive = SkColorSetRGB(0x26, 0x26, 0x26),
+    .toolbar = SkColorSetRGB(0x38, 0x38, 0x38),
+    .tab_hover = SkColorSetRGB(0x32, 0x32, 0x32),
+    .omnibox = SkColorSetRGB(0x2C, 0x2C, 0x2C),
+    .text = SkColorSetRGB(0xF2, 0xF2, 0xF2),
+    .text_muted = SkColorSetRGB(0xA9, 0xB4, 0xB8),
+    .icon = SkColorSetRGB(0xE6, 0xE6, 0xE6),
+    .separator = SkColorSetRGB(0x49, 0x49, 0x49),
+};
+
+bool ShouldApplyIceColors(const ui::ColorProviderKey& key) {
+  return !key.custom_theme && !key.app_controller &&
+         !key.user_color.has_value() &&
+         key.user_color_source ==
+             ui::ColorProviderKey::UserColorSource::kBaseline &&
+         key.system_theme == ui::SystemTheme::kDefault &&
+         key.forced_colors == ui::ColorProviderKey::ForcedColors::kNone &&
+         key.contrast_mode == ui::ColorProviderKey::ContrastMode::kNormal;
+}
+
+}  // namespace
+
+void AddIceColorMixer(ui::ColorProvider* provider,
+                      const ui::ColorProviderKey& key) {
+  if (!ShouldApplyIceColors(key)) {
+    return;
+  }
+
+  const IcePalette& p =
+      key.color_mode == ui::ColorProviderKey::ColorMode::kDark ? kIceDark
+                                                               : kIceLight;
+
+  ui::ColorMixer& mixer = provider->AddMixer();
+
+  // Window frame / tab strip.
+  mixer[ui::kColorFrameActive] = {p.frame};
+  mixer[ui::kColorFrameInactive] = {p.frame_inactive};
+  mixer[kColorFrameCaptionActive] = {p.text};
+  mixer[kColorFrameCaptionInactive] = {p.text_muted};
+
+  // Tabs.
+  mixer[kColorTabBackgroundActiveFrameActive] = {p.toolbar};
+  mixer[kColorTabBackgroundActiveFrameInactive] = {p.toolbar};
+  mixer[kColorDetachedTabBackgroundActiveFrameActive] = {p.toolbar};
+  mixer[kColorTabBackgroundInactiveFrameActive] = {p.frame};
+  mixer[kColorTabBackgroundInactiveFrameInactive] = {p.frame_inactive};
+  mixer[kColorTabBackgroundInactiveHoverFrameActive] = {p.tab_hover};
+  mixer[kColorTabBackgroundInactiveHoverFrameInactive] = {p.tab_hover};
+  mixer[kColorTabForegroundActiveFrameActive] = {p.text};
+  mixer[kColorTabForegroundActiveFrameInactive] = {p.text};
+  mixer[kColorTabForegroundInactiveFrameActive] = {p.text_muted};
+  mixer[kColorTabForegroundInactiveFrameInactive] = {p.text_muted};
+  mixer[kColorTabDividerFrameActive] = {p.separator};
+  mixer[kColorTabDividerFrameInactive] = {p.separator};
+  mixer[kColorNewTabButtonCRForegroundFrameActive] = {p.text};
+  mixer[kColorNewTabButtonCRForegroundFrameInactive] = {p.text_muted};
+
+  // Toolbar (also the background of the Ice rail) and bookmarks bar.
+  mixer[kColorToolbar] = {p.toolbar};
+  mixer[kColorToolbarButtonIconDefault] = {p.icon};
+  mixer[kColorToolbarButtonText] = {p.text};
+  mixer[kColorToolbarTextDefault] = {p.text};
+  mixer[kColorToolbarSeparatorDefault] = {p.separator};
+  mixer[kColorToolbarExtensionSeparatorEnabled] = {p.separator};
+  mixer[kColorToolbarTopSeparatorFrameActive] = {p.toolbar};
+  mixer[kColorToolbarTopSeparatorFrameInactive] = {p.toolbar};
+  mixer[kColorToolbarContentAreaSeparator] = {p.toolbar};
+  mixer[kColorBookmarkBarBackground] = {p.toolbar};
+  mixer[kColorBookmarkBarForeground] = {p.text};
+  mixer[kColorBookmarkBarSeparatorChromeRefresh] = {p.separator};
+
+  // Omnibox: a frame-coloured pill on the toolbar.
+  mixer[kColorToolbarBackgroundSubtleEmphasis] = {p.omnibox};
+  mixer[kColorOmniboxText] = {p.text};
+  mixer[kColorOmniboxTextDimmed] = {p.text_muted};
+}

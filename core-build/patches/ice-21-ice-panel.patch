+
+void IceOverlayPanel::ShowPageInPanel(const GURL& url) {
+  if (!web_contents_) {
+    return;
+  }
+  content::NavigationController::LoadURLParams params(url);
+  params.transition_type = ui::PAGE_TRANSITION_AUTO_TOPLEVEL;
+  web_contents_->GetController().LoadURLWithParams(params);
+}
+
+void IceOverlayPanel::ClosePanel() {
+  Close();
+}
+
+bool IceOverlayPanel::HandleKeyboardEvent(
+    content::WebContents* source,
+    const input::NativeWebKeyboardEvent& event) {
+  // Lets Escape (and other accelerators of the bubble) work while the page
+  // has focus.
+  if (!bubble_ || !bubble_->widget) {
+    return false;
+  }
+  return unhandled_keyboard_event_handler_.HandleKeyboardEvent(
+      event, bubble_->widget->GetFocusManager());
+}
+
+void IceOverlayPanel::CloseContents(content::WebContents* source) {
+  // window.close() from an extension popup shown in the panel.
+  Close();
+}
+
+void IceOverlayPanel::DidFinishNavigation(
+    content::NavigationHandle* navigation_handle) {
+  UpdateBackBar();
+}
+
+content::WebContents* IceOverlayPanel::GetOrCreateWebContents() {
+  if (!web_contents_) {
+    web_contents_ = content::WebContents::Create(
+        content::WebContents::CreateParams(browser_->GetProfile()));
+    web_contents_->SetDelegate(this);
+    Observe(web_contents_.get());
+    IcePanelHost::CreateForWebContents(web_contents_.get(), this);
+    // Extension pages (popups shown in the panel) need the extension frame
+    // host for their chrome.* APIs, as in a tab.
+    extensions::ChromeExtensionWebContentsObserver::CreateForWebContents(
+        web_contents_.get());
+  }
+  return web_contents_.get();
+}
+
+void IceOverlayPanel::LoadPanelPage(Mode mode) {
+  content::WebContents* web_contents = GetOrCreateWebContents();
+  const GURL url = GetPanelUrl(mode);
+  if (web_contents->GetLastCommittedURL() == url) {
+    return;
+  }
+  // Only the fragment differs while chrome://ice-panel is shown: that is a
+  // same-document navigation and the page switches mode on "hashchange".
+  content::NavigationController::LoadURLParams params(url);
+  params.transition_type = ui::PAGE_TRANSITION_AUTO_TOPLEVEL;
+  web_contents->GetController().LoadURLWithParams(params);
+}
+
+bool IceOverlayPanel::IsShowingPanelPage() const {
+  if (!web_contents_) {
+    return true;
+  }
+  const GURL& url = web_contents_->GetLastCommittedURL();
+  return url.is_empty() || (url.SchemeIs(content::kChromeUIScheme) &&
+                            url.host() == kChromeUIIcePanelHost);
+}
+
+void IceOverlayPanel::GoBackToPanelPage() {
+  LoadPanelPage(mode_);
+}
+
+void IceOverlayPanel::UpdateBackBar() {
+  if (bubble_ && bubble_->back_bar) {
+    bubble_->back_bar->SetVisible(!IsShowingPanelPage());
+  }
+}

+// The three Ice switches (applied after a restart). `addon_dir` names the
+// add-on directory under <install>/dodaci, `builtin_id` the built-in.
+struct IceSwitch {
+  const char* pref;
+  const char* name;
+  const char* addon_dir;
+  const char* builtin_id;
+};
+constexpr IceSwitch kIceSwitches[] = {
+    {kSnDownloaderEnabledPref, "Ultimate SN Downloader", "sn-downloader",
+     nullptr},
+    {kVideoSnifferEnabledPref, "Video Sniffer", "video-sniffer", nullptr},
+    {kMultiselectEnabledPref, "Multiselect for YouTube", nullptr,
+     "gpgbiinpmelaihndlegbgfkmnpofgfei"},
+};

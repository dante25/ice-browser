+class IcePanelHandler : public content::WebUIMessageHandler {
+ public:
+  IcePanelHandler() = default;
+  IcePanelHandler(const IcePanelHandler&) = delete;
+  IcePanelHandler& operator=(const IcePanelHandler&) = delete;
+  ~IcePanelHandler() override = default;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    Register("getState", &IcePanelHandler::HandleGetState);
+    Register("setPref", &IcePanelHandler::HandleSetPref);
+    Register("storageGet", &IcePanelHandler::HandleStorageGet);
+    Register("storageSet", &IcePanelHandler::HandleStorageSet);
+    Register("openPopup", &IcePanelHandler::HandleOpenPopup);
+    Register("openOptions", &IcePanelHandler::HandleOpenOptions);
+    Register("runCommand", &IcePanelHandler::HandleRunCommand);
+    Register("close", &IcePanelHandler::HandleClose);
+  }
+
+ private:
+  using Handler = void (IcePanelHandler::*)(const base::ListValue&);
+
+  void Register(std::string_view message, Handler handler) {
+    web_ui()->RegisterMessageCallback(
+        message, base::BindRepeating(&IcePanelHandler::Dispatch,
+                                     base::Unretained(this), handler));
+  }
+
+  // Every message must come from the chrome://ice-panel document itself.
+  void Dispatch(Handler handler, const base::ListValue& args) {
+    content::RenderFrameHost* frame = web_ui()->GetRenderFrameHost();
+    if (!frame) {
+      return;
+    }
+    const GURL& url = frame->GetLastCommittedURL();
+    if (!url.SchemeIs(content::kChromeUIScheme) ||
+        url.host() != kChromeUIIcePanelHost) {
+      return;
+    }
+    AllowJavascript();
+    (this->*handler)(args);
+  }
+
+  Profile* profile() { return Profile::FromWebUI(web_ui()); }
+  IcePanelHost::Delegate* delegate() {
+    return IcePanelHost::GetDelegate(web_ui()->GetWebContents());
+  }
+
+  // getState(callbackId) -> {switches, restartPending, features}.
+  void HandleGetState(const base::ListValue& args) {
+    if (args.empty()) {
+      return;
+    }
+    base::Value callback_id = args[0].Clone();
+    std::vector<IceExtension> ice_extensions = GetIceExtensions(profile());
+
+    std::vector<extensions::ExtensionResource> icons;
+    base::ListValue features;
+    for (const IceExtension& ice_extension : ice_extensions) {
+      const extensions::Extension* extension = ice_extension.extension.get();
+      const extensions::ActionInfo* action =
+          extensions::ActionInfo::GetExtensionActionInfo(extension);
+      features.Append(
+          base::DictValue()
+              .Set("id", extension->id())
+              .Set("dir", ice_extension.dir)
+              .Set("name", extension->name())
+              .Set("addon", ice_extension.addon)
+              .Set("popup", action && action->default_popup_url.is_valid())
+              .Set("options",
+                   extensions::OptionsPageInfo::HasOptionsPage(extension)));
+      icons.push_back(GetIconResource(extension));
+    }
+
+    base::ListValue switches;
+    PrefService* prefs = profile()->GetPrefs();
+    for (const IceSwitch& ice_switch : kIceSwitches) {
+      if (!prefs->FindPreference(ice_switch.pref)) {
+        continue;
+      }
+      base::DictValue entry;
+      entry.Set("pref", ice_switch.pref);
+      entry.Set("name", ice_switch.name);
+      entry.Set("value", prefs->GetBoolean(ice_switch.pref));
+      // Index of the matching loaded feature, for its icon.
+      for (size_t i = 0; i < ice_extensions.size(); ++i) {
+        const IceExtension& ice_extension = ice_extensions[i];
+        if ((ice_switch.addon_dir && ice_extension.addon &&
+             ice_extension.dir == ice_switch.addon_dir) ||
+            (ice_switch.builtin_id &&
+             ice_extension.extension->id() == ice_switch.builtin_id)) {
+          entry.Set("name", ice_extension.extension->name());
+          entry.Set("featureIndex", static_cast<int>(i));
+        }
+      }
+      switches.Append(std::move(entry));
+    }
+
+    base::DictValue state;
+    state.Set("features", std::move(features));
+    state.Set("switches", std::move(switches));
+    state.Set("restartPending", IsRestartPending(prefs));
+
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+         base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+        base::BindOnce(&LoadIconsAsDataUrls, std::move(icons)),
+        base::BindOnce(&IcePanelHandler::OnIconsLoaded,
+                       weak_factory_.GetWeakPtr(), std::move(callback_id),
+                       std::move(state)));
+  }
+
+  void OnIconsLoaded(base::Value callback_id,
+                     base::DictValue state,
+                     std::vector<std::string> icons) {
+    if (!IsJavascriptAllowed()) {
+      return;
+    }
+    base::ListValue* features = state.FindList("features");
+    for (size_t i = 0; features && i < features->size() && i < icons.size();
+         ++i) {
+      if (!icons[i].empty()) {
+        (*features)[i].GetDict().Set("icon", icons[i]);
+      }
+    }
+    base::ListValue* switches = state.FindList("switches");
+    for (size_t i = 0; switches && features && i < switches->size(); ++i) {
+      base::DictValue& entry = (*switches)[i].GetDict();
+      std::optional<int> index = entry.FindInt("featureIndex");
+      entry.Remove("featureIndex");
+      if (index && *index >= 0 && static_cast<size_t>(*index) < icons.size() &&
+          !icons[*index].empty()) {
+        entry.Set("icon", icons[*index]);
+      }
+    }
+    ResolveJavascriptCallback(callback_id, state);
+  }
+
+  // setPref(callbackId, name, value) for the three Ice switches only.
+  void HandleSetPref(const base::ListValue& args) {
+    if (args.size() < 3 || !args[1].is_string() || !args[2].is_bool()) {
+      return;
+    }
+    const std::string& name = args[1].GetString();
+    PrefService* prefs = profile()->GetPrefs();
+    bool known = false;
+    for (const IceSwitch& ice_switch : kIceSwitches) {
+      known = known || name == ice_switch.pref;
+    }
+    if (!known || !prefs->FindPreference(name)) {
+      RejectJavascriptCallback(args[0], base::Value("unknown pref"));
+      return;
+    }
+    OriginalSwitchValues().emplace(name, prefs->GetBoolean(name));
+    prefs->SetBoolean(name, args[2].GetBool());
+    ResolveJavascriptCallback(
+        args[0],
+        base::DictValue().Set("restartPending", IsRestartPending(prefs)));
+  }
+
+  // Validates (extensionId, area) of a storage call. Rejects and returns
+  // nullptr if they are not an Ice feature and "local"/"sync".
+  scoped_refptr<const extensions::Extension> GetStorageTarget(
+      const base::ListValue& args,
+      extensions::StorageAreaNamespace* area) {
+    std::optional<extensions::StorageAreaNamespace> parsed =
+        args.size() >= 3 && args[2].is_string()
+            ? ParseArea(args[2].GetString())
+            : std::nullopt;
+    scoped_refptr<const extensions::Extension> extension =
+        args.size() >= 2 && args[1].is_string()
+            ? FindIceExtension(profile(), args[1].GetString())
+            : nullptr;
+    extensions::StorageFrontend* frontend =
+        extensions::StorageFrontend::Get(profile());
+    if (!parsed || !extension || !frontend ||
+        !frontend->IsStorageEnabled(
+            *parsed == extensions::StorageAreaNamespace::kSync
+                ? extensions::settings_namespace::SYNC
+                : extensions::settings_namespace::LOCAL)) {
+      RejectJavascriptCallback(args[0], base::Value("not available"));
+      return nullptr;
+    }
+    *area = *parsed;
+    return extension;
+  }
+
+  // storageGet(callbackId, extensionId, "local"|"sync", keys|null) -> object.
+  // Same store as the extension's chrome.storage.<area>.
+  void HandleStorageGet(const base::ListValue& args) {
+    if (args.empty()) {
+      return;
+    }
+    extensions::StorageAreaNamespace area;
+    scoped_refptr<const extensions::Extension> extension =
+        GetStorageTarget(args, &area);
+    if (!extension) {
+      return;
+    }
+    std::optional<std::vector<std::string>> keys;
+    if (args.size() >= 4 && args[3].is_list()) {
+      keys.emplace();
+      for (const base::Value& key : args[3].GetList()) {
+        if (key.is_string()) {
+          keys->push_back(key.GetString());
+        }
+      }
+    }
+    extensions::StorageFrontend::Get(profile())->GetValues(
+        extension, area, std::move(keys),
+        base::BindOnce(&IcePanelHandler::OnStorageGet,
+                       weak_factory_.GetWeakPtr(), args[0].Clone()));
+  }
+
+  void OnStorageGet(base::Value callback_id,
+                    extensions::StorageFrontend::GetResult result) {
+    if (!IsJavascriptAllowed()) {
+      return;
+    }
+    if (!result.status.success) {
+      RejectJavascriptCallback(callback_id,
+                               base::Value(result.status.error.value_or("")));
+      return;
+    }
+    ResolveJavascriptCallback(
+        callback_id, result.data ? base::Value(std::move(*result.data))
+                                 : base::Value(base::DictValue()));
+  }
+
+  // storageSet(callbackId, extensionId, "local"|"sync", object). Goes through
+  // StorageFrontend, so the extension gets chrome.storage.onChanged.
+  void HandleStorageSet(const base::ListValue& args) {
+    if (args.empty()) {
+      return;
+    }
+    extensions::StorageAreaNamespace area;
+    scoped_refptr<const extensions::Extension> extension =
+        GetStorageTarget(args, &area);
+    if (!extension) {
+      return;
+    }
+    if (args.size() < 4 || !args[3].is_dict()) {
+      RejectJavascriptCallback(args[0], base::Value("bad values"));
+      return;
+    }
+    extensions::StorageFrontend::Get(profile())->Set(
+        extension, area, args[3].GetDict().Clone(),
+        base::BindOnce(&IcePanelHandler::OnStorageSet,
+                       weak_factory_.GetWeakPtr(), args[0].Clone()));
+  }
+
+  void OnStorageSet(base::Value callback_id,
+                    extensions::StorageFrontend::ResultStatus status) {
+    if (!IsJavascriptAllowed()) {
+      return;
+    }
+    if (!status.success) {
+      RejectJavascriptCallback(callback_id,
+                               base::Value(status.error.value_or("")));
+      return;
+    }
+    ResolveJavascriptCallback(callback_id, base::Value(true));
+  }
+
+  // openPopup(extensionId): the extension's own action popup, in the panel.
+  void HandleOpenPopup(const base::ListValue& args) {
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    scoped_refptr<const extensions::Extension> extension =
+        FindIceExtension(profile(), args[0].GetString());
+    const extensions::ActionInfo* action =
+        extension ? extensions::ActionInfo::GetExtensionActionInfo(
+                        extension.get())
+                  : nullptr;
+    IcePanelHost::Delegate* panel = delegate();
+    if (!action || !action->default_popup_url.is_valid() || !panel ||
+        !action->default_popup_url.SchemeIs(extensions::kExtensionScheme)) {
+      return;
+    }
+    panel->ShowPageInPanel(action->default_popup_url);
+  }
+
+  // openOptions(extensionId): the extension's options page, in a tab.
+  void HandleOpenOptions(const base::ListValue& args) {
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    scoped_refptr<const extensions::Extension> extension =
+        FindIceExtension(profile(), args[0].GetString());
+    if (!extension ||
+        !extensions::OptionsPageInfo::HasOptionsPage(extension.get())) {
+      return;
+    }
+    if (IcePanelHost::Delegate* panel = delegate()) {
+      BrowserWindowInterface* browser = panel->GetPanelBrowser();
+      panel->ClosePanel();
+      extensions::ExtensionTabUtil::OpenOptionsPage(extension.get(), browser);
+      return;
+    }
+    extensions::ExtensionTabUtil::OpenOptionsPageFromWebContents(
+        extension.get(), web_ui()->GetWebContents());
+  }
+
+  // runCommand(name): main menu entries + "restart".
+  void HandleRunCommand(const base::ListValue& args) {
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    const std::string& name = args[0].GetString();
+    if (name == "restart") {
+      chrome::AttemptRestart();
+      return;
+    }
+    IcePanelHost::Delegate* panel = delegate();
+    if (!panel) {
+      return;
+    }
+    for (const IcePanelCommand& command : kIcePanelCommands) {
+      if (name == command.name) {
+        panel->RunPanelCommand(command.command_id, command.keep_open);
+        return;
+      }
+    }
+  }
+
+  void HandleClose(const base::ListValue& args) {
+    if (IcePanelHost::Delegate* panel = delegate()) {
+      panel->ClosePanel();
+    }
+  }
+
+  base::WeakPtrFactory<IcePanelHandler> weak_factory_{this};
+};
+
+std::string_view GetResourcePath(const std::string& path) {
+  std::string_view result = path;
+  const size_t query = result.find_first_of("?#");
+  if (query != std::string_view::npos) {
+    result = result.substr(0, query);
+  }
+  return result;
+}
+
+bool ShouldHandleRequest(const std::string& path) {
+  const std::string_view resource = GetResourcePath(path);
+  return resource.empty() || resource == "index.html" ||
+         resource == "panel.css" || resource == "panel.js";
+}
+
+void HandleRequest(const std::string& path,
+                   content::WebUIDataSource::GotDataCallback callback) {
+  const std::string_view resource = GetResourcePath(path);
+  const char* content = kIcePanelHtml;
+  if (resource == "panel.css") {
+    content = kIcePanelCss;
+  } else if (resource == "panel.js") {
+    content = kIcePanelJs;
+  }
+  std::move(callback).Run(
+      base::MakeRefCounted<base::RefCountedString>(std::string(content)));
+}
+
+}  // namespace
+
+IcePanelUI::IcePanelUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      Profile::FromWebUI(web_ui), kChromeUIIcePanelHost);
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ScriptSrc, "script-src 'self';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::StyleSrc, "style-src 'self';");
+  // Feature icons are data: URLs (read from the extensions' own files).
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ImgSrc, "img-src 'self' data:;");
+  source->SetRequestFilter(base::BindRepeating(&ShouldHandleRequest),
+                           base::BindRepeating(&HandleRequest));
+
+  web_ui->AddMessageHandler(std::make_unique<IcePanelHandler>());
+}
+
+IcePanelUI::~IcePanelUI() = default;
+
+}  // namespace ice

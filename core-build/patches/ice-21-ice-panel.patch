+/* Switch */
+.switch { position: relative; width: 34px; height: 20px; flex: none; }
+.switch input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
+.switch span {
+  position: absolute; inset: 0; border-radius: 10px; background: var(--track);
+  transition: background .15s; pointer-events: none;
+}
+.switch span::after {
+  content: ""; position: absolute; top: 3px; left: 3px; width: 14px; height: 14px;
+  border-radius: 50%; background: #fff; transition: transform .15s;
+  box-shadow: 0 1px 2px rgba(0, 0, 0, .25);
+}
+.switch input:checked + span { background: var(--accent-strong); }
+.switch input:checked + span::after { transform: translateX(14px); }
+.switch input:focus-visible + span { outline: 2px solid var(--accent-strong); outline-offset: 2px; }
+
+.restart {
+  display: flex; align-items: center; gap: 8px; margin: 2px 8px 0;
+  color: var(--muted); font-size: 12px;
+}
+.restart span { flex: 1; }
+.btn {
+  border: 1px solid var(--border); background: var(--field); border-radius: 8px;
+  padding: 5px 12px;
+}
+.btn:hover { border-color: var(--accent-strong); }
+.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
+.actions { display: flex; gap: 6px; margin-top: 12px; }
+.body > .actions:first-child { margin-top: 0; }

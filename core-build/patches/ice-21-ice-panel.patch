+
+// Value of each switch pref when it was first changed from the panel in this
+// browser session; a restart is pending while any differs from it.
+std::map<std::string, bool>& OriginalSwitchValues() {
+  static base::NoDestructor<std::map<std::string, bool>> values;
+  return *values;
+}
+
+bool IsRestartPending(PrefService* prefs) {
+  for (const auto& [pref, original] : OriginalSwitchValues()) {
+    if (prefs->GetBoolean(pref) != original) {
+      return true;
+    }
+  }
+  return false;
+}
+
+struct IceExtension {
+  scoped_refptr<const extensions::Extension> extension;
+  std::string dir;
+  bool addon = false;
+};
+
+// The loaded Ice features: the built-ins (component extensions) and the
+// add-ons loaded from <install>/dodaci/<dir>.
+std::vector<IceExtension> GetIceExtensions(content::BrowserContext* context) {
+  std::vector<IceExtension> result;
+  const extensions::ExtensionSet& enabled =
+      extensions::ExtensionRegistry::Get(context)->enabled_extensions();
+  for (const IceBuiltin& builtin : GetIceBuiltins()) {
+    if (const extensions::Extension* extension =
+            enabled.GetByID(builtin.id)) {
+      result.push_back({base::WrapRefCounted(extension), builtin.dir, false});
+    }
+  }
+  const base::FilePath addons_dir_name =
+      base::FilePath::FromASCII(kIceAddonsDirName);
+  for (const scoped_refptr<const extensions::Extension>& extension : enabled) {
+    if (IsIceBuiltinExtension(extension->id()) ||
+        extension->location() !=
+            extensions::mojom::ManifestLocation::kCommandLine) {
+      continue;
+    }
+    const base::FilePath& path = extension->path();
+    if (path.DirName().BaseName() == addons_dir_name) {
+      result.push_back({extension, path.BaseName().AsUTF8Unsafe(), true});
+    }
+  }
+  return result;
+}
+
+scoped_refptr<const extensions::Extension> FindIceExtension(
+    content::BrowserContext* context,
+    const std::string& id) {
+  for (IceExtension& ice_extension : GetIceExtensions(context)) {
+    if (ice_extension.extension->id() == id) {
+      return std::move(ice_extension.extension);
+    }
+  }
+  return nullptr;
+}
+
+// Runs on a blocking pool: reads the icons and returns them as data: URLs
+// ("" when missing).
+std::vector<std::string> LoadIconsAsDataUrls(
+    std::vector<extensions::ExtensionResource> resources) {
+  constexpr int64_t kMaxIconBytes = 256 * 1024;
+  std::vector<std::string> urls;
+  for (const extensions::ExtensionResource& resource : resources) {
+    std::string url;
+    const base::FilePath path =
+        resource.empty() ? base::FilePath() : resource.GetFilePath();
+    std::optional<int64_t> size =
+        path.empty() ? std::nullopt : base::GetFileSize(path);
+    std::string data;
+    if (size.has_value() && *size > 0 && *size <= kMaxIconBytes &&
+        base::ReadFileToString(path, &data)) {
+      const std::string ext = base::ToLowerASCII(path.Extension());
+      const char* mime = "image/png";
+      if (ext == ".svg") {
+        mime = "image/svg+xml";
+      } else if (ext == ".jpg" || ext == ".jpeg") {
+        mime = "image/jpeg";
+      } else if (ext == ".webp") {
+        mime = "image/webp";
+      } else if (ext == ".gif") {
+        mime = "image/gif";
+      }
+      url = std::string("data:") + mime + ";base64," + base::Base64Encode(data);
+    }
+    urls.push_back(std::move(url));
+  }
+  return urls;
+}
+
+extensions::ExtensionResource GetIconResource(
+    const extensions::Extension* extension) {
+  extensions::ExtensionResource resource =
+      extensions::IconsInfo::GetIconResource(extension, 32,
+                                             ExtensionIconSet::Match::kBigger);
+  if (resource.empty()) {
+    resource = extensions::IconsInfo::GetIconResource(
+        extension, 32, ExtensionIconSet::Match::kSmaller);
+  }
+  return resource;
+}

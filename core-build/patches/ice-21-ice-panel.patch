+// Main menu entries of the panel (#menu) -> browser commands.
+struct IcePanelCommand {
+  const char* name;
+  int command_id;
+  bool keep_open;
+};
+constexpr IcePanelCommand kIcePanelCommands[] = {
+    {"newTab", IDC_NEW_TAB, false},
+    {"newWindow", IDC_NEW_WINDOW, false},
+    {"incognito", IDC_NEW_INCOGNITO_WINDOW, false},

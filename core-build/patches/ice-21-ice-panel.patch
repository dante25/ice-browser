+.ico img { width: 16px; height: 16px; }
+.ico svg { width: 14px; height: 14px; fill: var(--muted); }
+
+.card.open > .row { background: var(--accent); color: var(--on-accent); }
+.card.open > .row .chev { transform: rotate(90deg); fill: var(--on-accent); }
+.chev { width: 14px; height: 14px; fill: var(--muted); flex: none; transition: transform .15s; }
+.body {
+  background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
+  padding: 12px; margin: 8px 0 10px;
+}
+.body h3 { font-size: 13px; margin: 0 0 8px; }
+.body > * + .group, .body > .group + * { margin-top: 12px; }
+.body .note { color: var(--muted); margin: 0; font-size: 12px; }
+.chips { display: flex; flex-wrap: wrap; gap: 6px; }
+.chip {
+  border: 1px solid var(--border); background: var(--field); border-radius: 6px;
+  padding: 4px 10px;
+}
+.chip:hover { border-color: var(--accent-strong); }
+.chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
+
+.opt { display: flex; align-items: center; gap: 10px; min-height: 30px; }
+.opt .name { flex: 1; }
+.opt input[type="color"] {
+  width: 36px; height: 24px; border: 1px solid var(--border); border-radius: 6px;
+  background: var(--field); padding: 1px; cursor: pointer;
+}
+.stats { display: grid; grid-template-columns: 1fr auto; gap: 2px 8px; }
+.stats b { text-align: right; }

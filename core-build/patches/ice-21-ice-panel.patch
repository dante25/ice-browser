+class BrowserWindowInterface;
+class GURL;
+
+namespace ice {
+
+inline constexpr char kChromeUIIcePanelHost[] = "ice-panel";
+inline constexpr char kChromeUIIcePanelURL[] = "chrome://ice-panel/";
+
+// Connects the chrome://ice-panel page to the native panel that hosts it (the
+// Ice sidebar overlay panel). Attached to the panel's WebContents by the
+// panel, which owns that WebContents and so outlives this object.
+class IcePanelHost : public content::WebContentsUserData<IcePanelHost> {
+ public:
+  class Delegate {
+   public:
+    // The browser window the panel belongs to.
+    virtual BrowserWindowInterface* GetPanelBrowser() = 0;
+    // Runs a browser command (IDC_*) in that window. The panel is closed
+    // first unless `keep_open` is true (e.g. zoom).
+    virtual void RunPanelCommand(int command_id, bool keep_open) = 0;
+    // Shows `url` (an extension's own popup page) inside the panel, with a
+    // native back button that returns to chrome://ice-panel.
+    virtual void ShowPageInPanel(const GURL& url) = 0;
+    virtual void ClosePanel() = 0;
+
+   protected:
+    virtual ~Delegate() = default;
+  };
+
+  IcePanelHost(const IcePanelHost&) = delete;
+  IcePanelHost& operator=(const IcePanelHost&) = delete;
+  ~IcePanelHost() override;
+
+  // Returns the delegate of the panel that hosts `web_contents`, or nullptr
+  // (e.g. chrome://ice-panel opened in a normal tab).
+  static Delegate* GetDelegate(content::WebContents* web_contents);
+
+  Delegate* delegate() { return delegate_; }
+
+ private:
+  friend class content::WebContentsUserData<IcePanelHost>;
+  IcePanelHost(content::WebContents* web_contents, Delegate* delegate);
+
+  const raw_ptr<Delegate> delegate_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+class IcePanelUI;
+
+class IcePanelUIConfig : public content::DefaultWebUIConfig<IcePanelUI> {
+ public:
+  IcePanelUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIScheme, kChromeUIIcePanelHost) {}
+};
+
+// chrome://ice-panel: the content of the Ice sidebar panel ("Funkcije" and
+// the main menu). HTML/CSS/JS are compiled in (ice_panel_resources.h).
+class IcePanelUI : public content::WebUIController {
+ public:
+  explicit IcePanelUI(content::WebUI* web_ui);
+  IcePanelUI(const IcePanelUI&) = delete;
+  IcePanelUI& operator=(const IcePanelUI&) = delete;
+  ~IcePanelUI() override;
+};
+

+.zoom { display: flex; align-items: center; gap: 4px; }
+.zoom .btn { padding: 3px 10px; min-width: 32px; }
+.sep { height: 1px; background: var(--border); margin: 10px 6px; }
+.menu-item.danger { color: var(--danger); }

+std::optional<extensions::StorageAreaNamespace> ParseArea(
+    const std::string& area) {
+  if (area == "local") {
+    return extensions::StorageAreaNamespace::kLocal;
+  }
+  if (area == "sync") {
+    return extensions::StorageAreaNamespace::kSync;
+  }
+  return std::nullopt;
+}

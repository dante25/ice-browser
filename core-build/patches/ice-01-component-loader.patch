+void ComponentLoader::AddIceBuiltinExtensions() {
+  base::FilePath resources_dir;
+  if (!base::PathService::Get(chrome::DIR_RESOURCES, &resources_dir)) {
+    return;
+  }
+  const base::FilePath root =
+      resources_dir.AppendASCII(ice::kIceBuiltinsDirName);
+  PrefService* prefs = profile_->GetPrefs();
+  for (const ice::IceBuiltin& builtin : ice::GetIceBuiltins()) {
+    if (builtin.enable_pref && prefs->FindPreference(builtin.enable_pref) &&
+        !prefs->GetBoolean(builtin.enable_pref)) {
+      continue;
+    }
+    const base::FilePath dir = root.AppendASCII(builtin.dir);
+    GetExtensionFileTaskRunner()->PostTaskAndReplyWithResult(
+        FROM_HERE, base::BindOnce(&LoadIceBuiltinOnFileThread, builtin, dir),
+        base::BindOnce(&ComponentLoader::FinishAddIceBuiltin,
+                       weak_factory_.GetWeakPtr(), dir,
+                       ExtensionId(builtin.id)));
+  }
+}
+
+void ComponentLoader::FinishAddIceBuiltin(
+    const base::FilePath& root_directory,
+    const ExtensionId& expected_id,
+    std::optional<base::DictValue> manifest) {
+  if (!manifest) {
+    return;
+  }
+  // The ID comes from the manifest "key" and must match the compiled-in list.
+  // This also avoids the CHECK in GenerateId() for a manifest without a key.
+  if (TryGenerateId(*manifest) != expected_id) {
+    LOG(ERROR) << "Ice built-in at " << root_directory
+               << " not loaded, unexpected extension ID.";
+    return;
+  }
+  if (Exists(expected_id)) {
+    return;
+  }
+  Add(std::move(*manifest), root_directory, /*skip_allowlist=*/true);
+}

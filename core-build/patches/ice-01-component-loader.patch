+// Ice: runs on the extension file task runner. Verifies the shipped files
+// against the SHA-256 list compiled into the browser, then loads and localizes
+// the manifest (ComponentLoader only localizes on ChromeOS).
+std::optional<base::DictValue> LoadIceBuiltinOnFileThread(
+    const ice::IceBuiltin builtin,
+    const base::FilePath& root_directory) {
+  std::string error;
+  if (!ice::VerifyIceBuiltinFiles(builtin, root_directory, &error)) {
+    LOG(ERROR) << "Ice built-in '" << builtin.dir
+               << "' not loaded, integrity check failed: " << error;
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> manifest =
+      file_util::LoadManifest(root_directory, &error);
+  if (!manifest) {
+    LOG(ERROR) << "Ice built-in '" << builtin.dir
+               << "' not loaded, bad manifest: " << error;
+    return std::nullopt;
+  }
+  if (!extension_l10n_util::LocalizeExtension(
+          root_directory, &manifest.value(),
+          extension_l10n_util::GzippedMessagesPermission::kDisallow, &error)) {
+    LOG(ERROR) << "Ice built-in '" << builtin.dir
+               << "' not loaded, localization failed: " << error;
+    return std::nullopt;
+  }
+  return manifest;
+}

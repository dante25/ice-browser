-      info.id, GetMaximumRulesPerRuleset(), extension.id(), info.enabled);
+  base::FilePath indexed_path = extension.path().Append(
+      file_util::GetIndexedRulesetRelativePath(info.id.value()));
+  // Ice: component extensions are installed read-only and are never indexed
+  // by an installer, so keep their indexed static rulesets in the user data
+  // directory. The JSON source stays in the (unchanged) extension directory.
+  if (extension.location() == ::extensions::mojom::ManifestLocation::kComponent &&
+      ExtensionsBrowserClient::Get()) {
+    base::FilePath user_data_dir =
+        ExtensionsBrowserClient::Get()->GetUserDataDir();
+    if (!user_data_dir.empty()) {
+      indexed_path =
+          user_data_dir.AppendASCII("Ice Component Rulesets")
+              .AppendASCII(extension.id())
+              .AppendASCII(extension.version().GetString())
+              .Append(file_util::GetIndexedRulesetRelativePath(info.id.value()));
+    }
+  }
+  return FileBackedRulesetSource(extension.path().Append(info.relative_path),
+                                 indexed_path, info.id,
+                                 GetMaximumRulesPerRuleset(), extension.id(),
+                                 info.enabled);
 }
 

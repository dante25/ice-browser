{
  "manifest_version": 3,
  "name": "Uvoz iz drugog browsera",
  "short_name": "Uvoz",
  "version": "1.0.0",
  "description": "Uvoz bookmarksa, historije, lozinki i dozvola stranica iz Chromea, Bravea, Edgea, Vivaldija, Opere, Chromiuma i Firefoxa.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "action": {
    "default_popup": "uvoz.html",
    "default_title": "Uvoz iz drugog browsera",
    "default_icon": { "16": "icons/ice-16.png", "32": "icons/ice-32.png" }
  },
  "options_page": "uvoz.html",
  "icons": { "16": "icons/ice-16.png", "32": "icons/ice-32.png", "48": "icons/ice-48.png", "128": "icons/ice-128.png" }
}

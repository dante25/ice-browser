{
   "action": {
      "default_popup": "data/popup/index.html",
      "default_title": "Permanent Progress Bar for YouTube"
   },
   "background": {
      "service_worker": "worker.js"
   },
   "commands": {
      "_execute_action": {
      },
      "toggle_display": {
         "description": "Use this shortcut to show or hide the permanent progress bar"
      }
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "data/inject/main.js" ],
      "matches": [ "*://www.youtube.com/*" ],
      "run_at": "document_start",
      "world": "MAIN"
   }, {
      "all_frames": true,
      "css": [ "data/inject/isolated.css" ],
      "js": [ "data/inject/isolated.js" ],
      "matches": [ "*://www.youtube.com/*" ],
      "run_at": "document_start",
      "world": "ISOLATED"
   } ],
   "default_locale": "en",
   "description": "__MSG_description__",
   "homepage_url": "https://webextension.org/listing/youtube-tools.html?from=progress",
   "host_permissions": [ "*://www.youtube.com/*" ],
   "icons": {
      "128": "data/icons/128.png",
      "16": "data/icons/16.png",
      "256": "data/icons/256.png",
      "32": "data/icons/32.png",
      "48": "data/icons/48.png",
      "512": "data/icons/512.png",
      "64": "data/icons/64.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Permanent Progress Bar for YouTube",
   "options_ui": {
      "open_in_tab": true,
      "page": "data/options/index.html"
   },
   "permissions": [ "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "0.3.3"
}

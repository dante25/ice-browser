+
+    /** Ice: Colours (Ice / system / custom), stored by IceColorMode, applied to open windows at once. */
+    private void initIceColors() {
+        ListPreference mode = (ListPreference) findPreference(IceColorMode.PREF_MODE);
+        EditTextPreference custom = (EditTextPreference) findPreference(IceColorMode.PREF_CUSTOM);
+        mode.setPersistent(false);
+        custom.setPersistent(false);
+        mode.setValue(IceColorMode.getMode());
+        custom.setText(IceColorMode.getCustomColorText());
+        custom.setVisible(IceColorMode.CUSTOM.equals(mode.getValue()));
+        mode.setSummaryProvider(ListPreference.SimpleSummaryProvider.getInstance());
+        custom.setSummaryProvider(preference -> IceColorMode.getCustomColorText());
+        mode.setOnPreferenceChangeListener(
+                (preference, newValue) -> {
+                    String value = (String) newValue;
+                    IceColorMode.setMode(value);
+                    custom.setVisible(IceColorMode.CUSTOM.equals(value));
+                    IceColorMode.applyToRunningActivities();
+                    return true;
+                });
+        custom.setOnPreferenceChangeListener(
+                (preference, newValue) -> {
+                    String value = (String) newValue;
+                    if (!IceColorMode.isValidColor(value)) return false;
+                    IceColorMode.setCustomColorText(value);
+                    IceColorMode.applyToRunningActivities();
+                    return true;
+                });
     }
 

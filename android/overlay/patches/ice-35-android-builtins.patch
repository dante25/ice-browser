+#include "chrome/browser/extensions/ice_android_assets_digest.inc"
+
+constexpr char kIceAndroidStampName[] = ".ice-assets";
+
+bool ExtractIceAndroidAssets(const base::FilePath& root) {
+  const base::FilePath stamp = root.AppendASCII(kIceAndroidStampName);
+  std::string have;
+  if (base::ReadFileToString(stamp, &have) && have == kIceAndroidAssetsDigest) {
+    return true;
+  }
+  if (!base::DeletePathRecursively(root) || !base::CreateDirectory(root)) {
+    LOG(ERROR) << "Ice: cannot create " << root;
+    return false;
+  }
+  for (const IceAndroidAsset& entry : kIceAndroidAssets) {
+    const std::string name = std::string("assets/") + entry.asset;
+    base::MemoryMappedFile::Region region;
+    int fd = base::android::OpenApkAsset(name, &region);
+    if (fd < 0) {
+      // In an app bundle the assets of chrome_java are in the "chrome" split.
+      fd = base::android::OpenApkAsset(name, "chrome", &region);
+    }
+    if (fd < 0) {
+      LOG(ERROR) << "Ice: APK asset missing: " << name;
+      return false;
+    }
+    base::File file(fd);
+    std::vector<uint8_t> data(region.size);
+    if (region.size && !file.ReadAndCheck(region.offset, data)) {
+      LOG(ERROR) << "Ice: cannot read APK asset " << name;
+      return false;
+    }
+    const base::FilePath out = root.Append(base::FilePath(entry.path));
+    if (!base::CreateDirectory(out.DirName()) || !base::WriteFile(out, data)) {
+      LOG(ERROR) << "Ice: cannot write " << out;
+      return false;
+    }
+  }
+  // Written last: an interrupted extraction is redone on the next start.
+  return base::WriteFile(stamp, std::string_view(kIceAndroidAssetsDigest));
+}

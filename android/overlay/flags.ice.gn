# Extra GN args for the Ice Android build (appended to android_flags.gn of ungoogled-chromium-android).
# Extension support is already in the upstream patches of 156.0.8078.79-1 (Extensions/android-extensions-support.patch,
# feature EnableExtensionsAndroid on by default, Extensions/Ultimatum/load-crx.patch).

# Own package name: Ice installs next to Chrome / Ungoogled Chromium instead of replacing them.
chrome_public_manifest_package = "org.ice.browser"
